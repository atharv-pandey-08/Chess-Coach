# Copy to .env and adjust. Every setting is optional.

# Your Chess.com username (the web app also lets you type any username)
CHESS_COM_USERNAME=Atrowk

# Enables "Rewrite with AI" (the engine coach works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Engine settings
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
ANALYSIS_DEPTH=14
# ENGINE_THREADS=8
# ENGINE_HASH_MB=128

# Web server
# PORT=5050
# OPEN_BROWSER=1
